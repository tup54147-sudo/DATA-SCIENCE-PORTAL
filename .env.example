PORT=3000
SESSION_SECRET=replace-this-with-a-long-random-secret
NODE_ENV=development

# Optional TURN relay (recommended for real classes — see LIVE_CLASS_GUIDE.md)
# TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# SMS phone verification (students must verify a Nigerian number when registering)
# Leave blank in development: the code is printed in the server console and shown on the page.
# In production (NODE_ENV=production) a provider key is REQUIRED or registration SMS will fail.
# TERMII_API_KEY=
# TERMII_SENDER_ID=N-Alert
# TERMII_CHANNEL=dnd
